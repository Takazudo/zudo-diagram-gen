{
  "name": "@takazudo/zudo-diagram-gen",
  "version": "0.1.0",
  "description": "A zfb-based workspace for comparing and refining SVG diagram candidates.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22 <25" },
  "exports": {
    ".": { "types": "./src/index.d.ts", "default": "./src/index.mjs" },
    "./model": "./src/model.mjs",
    "./render": "./src/render.mjs",
    "./schemas/*": "./schemas/*"
  },
  "bin": { "zudo-diagram-gen": "./src/cli.mjs" },
  "scripts": { "prepack": "node src/verify-package.mjs" },
  "files": ["src", "client", "tones", "schemas", "README.md", "LICENSE"],
  "dependencies": { "saxes": "6.0.0" },
  "peerDependencies": { "@takazudo/zfb": "^2.21.1", "preact": "^10.29.1" }
}
