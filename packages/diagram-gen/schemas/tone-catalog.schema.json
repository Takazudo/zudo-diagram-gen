{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagram tone collection",
  "description": "Package-owned tones/catalog.json. Tone IDs and numbers must be unique. Reference SVG paths are relative to the tones directory. The CLI checks these cross-record and filesystem requirements.",
  "type": "object",
  "required": ["schemaVersion", "version", "tones"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "$ref": "common.schema.json#/$defs/nonemptyString"
    },
    "tones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "number",
          "name",
          "family",
          "summary",
          "recipe",
          "goodFor",
          "smallSizeNotes",
          "referenceFiles"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "number": {
            "$ref": "common.schema.json#/$defs/order"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/nonemptyString"
          },
          "family": {
            "$ref": "common.schema.json#/$defs/nonemptyString"
          },
          "summary": {
            "$ref": "common.schema.json#/$defs/nonemptyString"
          },
          "recipe": {
            "$ref": "common.schema.json#/$defs/stringList"
          },
          "goodFor": {
            "$ref": "common.schema.json#/$defs/stringList"
          },
          "smallSizeNotes": {
            "$ref": "common.schema.json#/$defs/nonemptyString"
          },
          "referenceFiles": {
            "type": "object",
            "required": ["light", "dark"],
            "properties": {
              "light": {
                "$ref": "common.schema.json#/$defs/svgPath"
              },
              "dark": {
                "$ref": "common.schema.json#/$defs/svgPath"
              }
            }
          },
          "sourceReferences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "url"],
              "properties": {
                "title": {
                  "$ref": "common.schema.json#/$defs/nonemptyString"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^[Hh][Tt][Tt][Pp][Ss]?:"
                }
              }
            }
          },
          "scheme": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+/scheme\\.json$"
          },
          "kit": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+/kit\\.svg$"
          },
          "bundledReferences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "path", "required"],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/slug"
                },
                "title": {
                  "$ref": "common.schema.json#/$defs/nonemptyString"
                },
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\u0000])[^/]+(?:/[^/]+)*\\.(?:[mM][dD]|[jJ][sS][oO][nN])$"
                },
                "required": {
                  "type": "boolean"
                }
              }
            }
          },
          "recipeNumericReferences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["recipeIndex", "path", "value"],
              "additionalProperties": false,
              "properties": {
                "recipeIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "path": {
                  "type": "string",
                  "pattern": "^(?:coordinateSystem|geometry|typography|texture)\\.[A-Za-z0-9._-]+$"
                },
                "value": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  }
}
