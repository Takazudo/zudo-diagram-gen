{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagram placement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "frame", "slot", "fit"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "fit": { "const": "contain" },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "background"],
      "properties": {
        "width": { "$ref": "#/$defs/dimension" },
        "height": { "$ref": "#/$defs/dimension" },
        "background": { "type": "string", "pattern": "^(#[0-9A-Fa-f]{6}|transparent)$" }
      }
    },
    "slot": { "$ref": "#/$defs/rectangle" },
    "fonts": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": { "title": { "type": "string" }, "body": { "type": "string" } }
    },
    "images": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "x", "y", "width", "height"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "x": { "type": "number", "minimum": 0 },
          "y": { "type": "number", "minimum": 0 },
          "width": { "$ref": "#/$defs/dimension" },
          "height": { "$ref": "#/$defs/dimension" }
        }
      }
    }
  },
  "$defs": {
    "dimension": { "type": "number", "exclusiveMinimum": 0, "maximum": 20000 },
    "rectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "$ref": "#/$defs/dimension" },
        "height": { "$ref": "#/$defs/dimension" }
      }
    }
  }
}
