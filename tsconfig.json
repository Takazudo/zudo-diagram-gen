{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": null
  },
  "include": [
    "pages/**/*.tsx",
    "src/**/*.tsx",
    "src/generated/**/*.ts",
    "zfb.config.ts",
    "src/**/*.d.ts"
  ],
  "extends": "@takazudo/zudo-doc/tsconfig.base.json"
}
