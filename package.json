{
  "name": "zudo-diagram-gen-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-showcase.mjs && zfb build && node scripts/prepare-cloudflare-assets.mjs",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "rollback:cloudflare": "node scripts/rollback-cloudflare.mjs",
    "smoke:cloudflare": "node scripts/smoke-cloudflare.mjs",
    "preview": "zfb preview",
    "check": "node scripts/build-showcase.mjs && tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check package.json .prettierrc.json .mdx-formatter.json eslint.config.js vitest.config.mjs lefthook.yml .github/workflows .github/dependabot.yml test packages/diagram-gen/test packages/create-zudo-diagram-gen/test && mdx-formatter --check '**/*.{md,mdx}'",
    "format:code": "prettier --write '**/*.{js,mjs,ts,tsx,json,yml,yaml,css}'",
    "format:docs": "mdx-formatter --write '**/*.{md,mdx}'",
    "b4push": "bash scripts/run-b4push.sh",
    "prepare": "lefthook install",
    "check:examples": "node scripts/check-examples.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "check:site-browser": "node scripts/check-site-browser.mjs",
    "export:preview": "node scripts/export-preview.mjs",
    "pack:local": "node scripts/pack-local.mjs"
  },
  "dependencies": {
    "@takazudo/zfb": "2.21.1",
    "@takazudo/zfb-md-wasm": "2.21.1",
    "@takazudo/zfb-runtime": "2.21.1",
    "@takazudo/zudo-diagram-gen": "workspace:*",
    "@takazudo/zudo-doc": "5.27.0",
    "diff": "8.0.4",
    "hono": "4.13.9",
    "katex": "0.16.38",
    "preact": "10.29.2",
    "preact-render-to-string": "6.6.6",
    "tailwindcss": "4.2.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@takazudo/mdx-formatter": "1.3.0",
    "@types/node": "22.19.7",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "happy-dom": "20.10.6",
    "lefthook": "2.1.14",
    "playwright": "1.59.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2",
    "wrangler": "4.141.0"
  }
}
